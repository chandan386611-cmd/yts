# ==============================================================================
# Automated YouTube Shorts Pipeline Environment Configuration
# Copy this file to .env and populate your production secrets.
# ==============================================================================

# --- AI Script Generation (Google Gemini) ---
# Get key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Voiceover Generation (Cartesia Sonic + ElevenLabs + Edge-TTS Fallback) ---
# Cartesia Sonic: Hyper-realistic human voiceover engine (Get key at https://play.cartesia.ai/)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=7e8cb11d-37af-476b-ab8f-25da99b18644
CARTESIA_MODEL=sonic-latest

# ElevenLabs API Key & Settings (eleven_flash_v2_5 runs at 0.5 credits/character)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Automatic fallback to Microsoft Edge TTS when premium keys fail or are unset
USE_EDGE_TTS_FALLBACK=true
EDGE_TTS_VOICE=en-US-ChristopherNeural

# --- Visual Generation: Scene 0 Motion Hook (Fal.ai Kling Video) ---
# Generates genuine 5-second moving video for Scene 0 (9:16 vertical)
ENABLE_FAL_HOOK=true
FAL_KEY=your_fal_api_key_here
# Hard cost caps in USD to prevent runaway spending
FAL_DAILY_BUDGET_USD=1.00
FAL_MONTHLY_BUDGET_USD=25.00

# --- Visual Generation: Scenes 1-N Stills (Cloudflare Workers AI FLUX.1 Schnell) ---
# High-speed vertical AI still images animated via Ken Burns zoompan filters
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
# Optional: Free Pexels API key (20,000 free requests/month at https://www.pexels.com/api/)
# Note: High-res authentic photography also automatically pulls from Wikimedia Commons (100% free, no key needed)
PEXELS_API_KEY=

# --- YouTube Data API v3 (OAuth 2.0 Publishing) ---
# Generated via Google Cloud Console -> APIs & Services -> Credentials
# IMPORTANT: OAuth Consent Screen must be in "Production" mode so refresh token doesn't expire in 7 days!
YOUTUBE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_google_client_secret
YOUTUBE_REFRESH_TOKEN=your_oauth2_refresh_token_here
YOUTUBE_PRIVACY_STATUS=public
CONTAINS_SYNTHETIC_MEDIA=true

# --- Pacing, Language & Art-Direction Settings ---
NICHE_TOPIC=Dark Psychology & Human Behavior Facts
LANGUAGE=hinglish
VOICE_RATE=+14%
MIN_DURATION_SECONDS=40.0
MAX_DURATION_SECONDS=45.0
TARGET_MIN_WORDS=105
TARGET_MAX_WORDS=120
BG_MUSIC_VOLUME_DB=-22

# --- Optional Binary Paths (defaults to PATH if empty) ---
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
